YOUTUBE_API_KEY=your_youtube_data_api_key_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# 100% local/free AI
PYTHON_BIN=python
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CHUNK_SECONDS=120
LOCAL_WHISPER_WORKERS=auto
LOCAL_WHISPER_CPU_THREADS=0
LOCAL_WHISPER_SKIP_SILENCE=true
LOCAL_WHISPER_CHUNK_TIMEOUT_MS=600000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Automatic Library -> AI Studio source ingestion
# yt-dlp + EJS support are installed by requirements-local-ai.txt
# Maximum authenticated campaign asset stream size (default: 5 GiB).
CAMPAIGN_STREAM_MAX_BYTES=5368709120
INGEST_MAX_HEIGHT=720
YOUTUBE_AUTH_BROWSER=firefox
# Optional overrides; ClipBoost auto-detects the D: tool locations used by the desktop setup.
# NODE_BIN=D:\Apps\NodeJS\node.exe
# FFMPEG_BIN=D:\Apps\FFmpeg\bin

# Desktop auto-update via GitHub Releases
# Example:
# CLIPBOOST_UPDATE_OWNER=your-github-username
# CLIPBOOST_UPDATE_REPO=clipboost
CLIPBOOST_UPDATE_OWNER=OGC112
CLIPBOOST_UPDATE_REPO=clipboost


# Social platform OAuth connections (Publish)
# Register these exact loopback callbacks in each platform developer console:
# TikTok:   http://127.0.0.1:53682/oauth/callback/tiktok
# Instagram:http://127.0.0.1:53682/oauth/callback/instagram
# YouTube:  http://127.0.0.1:53682/oauth/callback/youtube
# Facebook: http://127.0.0.1:53682/oauth/callback/facebook
# X:        http://127.0.0.1:53682/oauth/callback/x
#
# The auth/token endpoint defaults are built into the desktop app.
# Override *_OAUTH_AUTH_URL, *_OAUTH_TOKEN_URL, *_OAUTH_SCOPES,
# *_OAUTH_TOKEN_AUTH, or *_OAUTH_REDIRECT_PORT only when your developer app requires it.

TIKTOK_OAUTH_CLIENT_ID=
TIKTOK_OAUTH_CLIENT_SECRET=

INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
