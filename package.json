{
  "name": "clipboost",
  "productName": "ClipBoost",
  "private": true,
  "version": "21.38.51",
  "description": "ClipBoost — Clean Discover Layout",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run build && electron-builder --win dir",
    "test": "node --test server/campaigns/core.test.js server/security/network.test.js server/settings/env.test.js server/storage/storage.test.js server/integrations/parsers.test.js server/video/analysis.test.js server/video/format.test.js server/video/captions.test.js server/video/precision-cut.test.js server/video/context-signals.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "lucide-react": "1.48.0",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.clipboost.desktop",
    "productName": "ClipBoost",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "scripts/**/*",
      "desktop/**/*",
      "requirements-local-ai.txt",
      ".env.example",
      "package.json",
      "index.html",
      "src/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ClipBoost-Setup-${version}.${ext}",
      "icon": "desktop/assets/clipboost.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ClipBoost",
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/assets/clipboost.ico",
      "uninstallerIcon": "desktop/assets/clipboost.ico",
      "installerHeaderIcon": "desktop/assets/clipboost.ico"
    }
  },
  "author": "ClipBoost"
}
