{
  "name": "clipboost",
  "productName": "ClipBoost",
  "private": true,
  "version": "21.29.0",
  "description": "ClipBoost 21.29.0 — Campaign-aware project library",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.clipboost.desktop",
    "productName": "ClipBoost",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "scripts/**/*",
      "desktop/**/*",
      "requirements-local-ai.txt",
      ".env.example",
      "package.json",
      "index.html",
      "src/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ClipBoost-Setup-${version}.${ext}",
      "icon": "desktop/assets/clipboost.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ClipBoost",
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/assets/clipboost.ico",
      "uninstallerIcon": "desktop/assets/clipboost.ico",
      "installerHeaderIcon": "desktop/assets/clipboost.ico"
    }
  },
  "author": "ClipBoost"
}
